! Export Visual3D FR3 measurements for offline impedance_instron preparation.
! Run after FullBuild for the selected subject, with that subject's workspace open.
! Change SUBJ to match the open workspace. Trial numbers follow staticN/MetabolicN.
! These ASCII files are not a run-ready Newton Cartesian subject bundle.
! The current Newton preparer also requires the original C3Ds, a subject model,
! marker/motion artifacts and a synchronized treadmill log. Keep the C3Ds:
! they supply sample clocks, platform calibration and provenance.

Set_Pipeline_Parameter
/PARAMETER_NAME=SUBJ
/PARAMETER_VALUE=F01
;

Set_Pipeline_Parameter
/PARAMETER_NAME=CAL_FOLDER
/PARAMETER_VALUE=C:\Users\jkuzm\OneDrive - University of Massachusetts\HRSL x UMILL-PUMA Fatigue - Fatigue\Data\&::SUBJ&\
;

Set_Pipeline_Parameter
/PARAMETER_NAME=EXPORT_FOLDER
/PARAMETER_VALUE=C:\Users\jkuzm\OneDrive - University of Massachusetts\HRSL x UMILL-PUMA Fatigue - Fatigue\V3D\Exports\ImpedanceInstron\&::SUBJ&\
;

For_Each
/ITERATION_PARAMETER_NAME=TRIAL
/ITEMS=1+2+3
;

Set_Pipeline_Parameter
/PARAMETER_NAME=STATIC_FILE
/PARAMETER_VALUE=::CAL_FOLDER&FR3_static&::TRIAL&.c3d
;

Set_Pipeline_Parameter
/PARAMETER_NAME=MOTION_FILE
/PARAMETER_VALUE=::CAL_FOLDER&FR3_Metabolic&::TRIAL&.c3d
;

Set_Pipeline_Parameter
/PARAMETER_NAME=TRIAL_EXPORT
/PARAMETER_VALUE=::EXPORT_FOLDER&FR3_&::TRIAL&\
;

! Original optical marker samples from the matched standing calibration.
! CAL1-3 are candidate heel-cluster markers; their placement must be verified.
Select_Active_File
/FILE_NAME=::STATIC_FILE
;

! Full native static target set, including pelvis/leg markers needed by a
! future subject-specific Cartesian marker and motion adapter.
Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&static_all_targets.txt
/SIGNAL_TYPES=TARGET
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_PRECISION=8
/NORMALIZE_DATA=FALSE
/EXPORT_NAN=TRUE
/CREATE_FOLDER_PATH=TRUE
;

For_Each
/ITERATION_PARAMETER_NAME=MARKER
/ITEMS=RCAL1+RCAL2+RCAL3+RTOE+RMT1H+RMT5H+LCAL1+LCAL2+LCAL3+LTOE+LMT1H+LMT5H
;

For_Each
/ITERATION_PARAMETER_NAME=AXIS
/ITEMS=X+Y+Z
;

Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&static_&::MARKER&_&::AXIS&.txt
/SIGNAL_TYPES=TARGET
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=::MARKER
/COMPONENT_SEQUENCE=::AXIS
/SIGNAL_PRECISION=8
/NORMALIZE_DATA=FALSE
/EXPORT_NAN=TRUE
/CREATE_FOLDER_PATH=TRUE
;

End_For_Each
/ITERATION_PARAMETER_NAME=AXIS
;

End_For_Each
/ITERATION_PARAMETER_NAME=MARKER
;

! Plate measurements for the standing file, including the load check.
For_Each
/ITERATION_PARAMETER_NAME=PLATE_SIGNAL
/ITEMS=FORCE+COFP+FREEMOMENT
;

For_Each
/ITERATION_PARAMETER_NAME=AXIS
/ITEMS=X+Y+Z
;

Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&::PLATE_SIGNAL&\static_FP1_&::AXIS&.txt
/SIGNAL_TYPES=::PLATE_SIGNAL
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=FP1
/COMPONENT_SEQUENCE=::AXIS
/SIGNAL_PRECISION=8
/USE_POINT_RATE=FALSE
/NORMALIZE_DATA=FALSE
/EXPORT_NAN=TRUE
/CREATE_FOLDER_PATH=TRUE
;

End_For_Each
/ITERATION_PARAMETER_NAME=AXIS
;

End_For_Each
/ITERATION_PARAMETER_NAME=PLATE_SIGNAL
;

! Full dynamic recording, without gait-cycle normalization or event cropping.
Select_Active_File
/FILE_NAME=::MOTION_FILE
;

Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&motion_all_targets.txt
/SIGNAL_TYPES=TARGET
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_PRECISION=8
/NORMALIZE_DATA=FALSE
/EXPORT_NAN=TRUE
/CREATE_FOLDER_PATH=TRUE
;

For_Each
/ITERATION_PARAMETER_NAME=MARKER
/ITEMS=RCAL1+RCAL2+RCAL3+RTOE+RMT1H+RMT5H+LCAL1+LCAL2+LCAL3+LTOE+LMT1H+LMT5H
;

For_Each
/ITERATION_PARAMETER_NAME=AXIS
/ITEMS=X+Y+Z
;

Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&motion_&::MARKER&_&::AXIS&.txt
/SIGNAL_TYPES=TARGET
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=::MARKER
/COMPONENT_SEQUENCE=::AXIS
/SIGNAL_PRECISION=8
/NORMALIZE_DATA=FALSE
/EXPORT_NAN=TRUE
/CREATE_FOLDER_PATH=TRUE
;

End_For_Each
/ITERATION_PARAMETER_NAME=AXIS
;

End_For_Each
/ITERATION_PARAMETER_NAME=MARKER
;

! Export Visual3D's derived force, center-of-pressure, and free-moment signals.
! Verify this treadmill's force-platform gain and calibration before using them
! as physical loads. FullBuild currently applies session-specific plate settings.
For_Each
/ITERATION_PARAMETER_NAME=PLATE_SIGNAL
/ITEMS=FORCE+COFP+FREEMOMENT
;

For_Each
/ITERATION_PARAMETER_NAME=AXIS
/ITEMS=X+Y+Z
;

Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&::PLATE_SIGNAL&\motion_FP1_&::AXIS&.txt
/SIGNAL_TYPES=::PLATE_SIGNAL
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=FP1
/COMPONENT_SEQUENCE=::AXIS
/SIGNAL_PRECISION=8
/USE_POINT_RATE=FALSE
/NORMALIZE_DATA=FALSE
/EXPORT_NAN=TRUE
/CREATE_FOLDER_PATH=TRUE
;

End_For_Each
/ITERATION_PARAMETER_NAME=AXIS
;

End_For_Each
/ITERATION_PARAMETER_NAME=PLATE_SIGNAL
;

! Body mass used by FullBuild for force normalization, when available.
Export_Data_To_Ascii_File
/FILE_NAME=::TRIAL_EXPORT&model_mass.txt
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=MASS
/SIGNAL_PRECISION=8
/CREATE_FOLDER_PATH=TRUE
;

End_For_Each
/ITERATION_PARAMETER_NAME=TRIAL
;
