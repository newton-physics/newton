(
    defaultPrim = "World"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["NewtonMPMSceneAPI"]
    )
    {
        float physics:gravityMagnitude = 10
        vector3f physics:gravityDirection = (0, 0, -1)
        int newton:maxSolverIterations = 250
        float newton:mpm:tolerance = 0.0001
        token[] newton:mpm:rheologySolvers = ["auto"]
        float newton:mpm:voxelSize = 0.1
        token newton:mpm:velocityBasisType = "trilinear"
        int newton:mpm:velocityBasisOrder = 1
    }

    def Material "SandMaterial" (
        prepend apiSchemas = ["NewtonMPMMaterialAPI"]
    )
    {
        float physics:density = 1000
        float newton:mpm:youngsModulus = 1e7
        float newton:mpm:poissonsRatio = 0.3
        float newton:mpm:elasticDamping = 0
        float newton:mpm:internalFriction = 0.68
        float newton:mpm:yieldPressure = 1e12
    }

    def Material "PackedSandMaterial" (
        prepend apiSchemas = ["NewtonMPMMaterialAPI"]
    )
    {
        float physics:density = 1200
        float newton:mpm:youngsModulus = 2e7
        float newton:mpm:poissonsRatio = 0.28
        float newton:mpm:elasticDamping = 200000
        float newton:mpm:initialPlasticVolumeStrain = 0.975
        float newton:mpm:internalFriction = 0.8
        float newton:mpm:yieldPressure = 8e11
    }

